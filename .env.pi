# ===== POLLEN Raspberry Pi Swarm Configuration (9 nodes: 1 central + 8 workers) =====
# Copy this file to .env.pi on the CENTRAL Pi and adjust.
#
# ── Topology ────────────────────────────────────────────────────────────────────
# Central Pi  (192.168.1.10) — runs petals-inference (4 blocks) + petals-proxy
# Worker Pi 1 (192.168.1.11) — 3 blocks
# Worker Pi 2 (192.168.1.12) — 3 blocks
# Worker Pi 3 (192.168.1.13) — 3 blocks
# Worker Pi 4 (192.168.1.14) — 3 blocks
# Worker Pi 5 (192.168.1.15) — 3 blocks
# Worker Pi 6 (192.168.1.16) — 3 blocks
# Worker Pi 7 (192.168.1.17) — 3 blocks
# Worker Pi 8 (192.168.1.18) — 3 blocks
# Total: 28 blocks (Qwen/Qwen2.5-7B-Instruct)
#
# ── Peer IDs ────────────────────────────────────────────────────────────────────
# Peer IDs are generated at runtime. Run the worker container once, grab the peer
# ID from the logs (look for "Running on <multiaddr>"), then fill them in below.
# Example (realistic format):
#   /ip4/192.168.1.11/tcp/31337/p2p/QmXeMabY7dDfPtV3KcJzRqL8Wn9Hp2TgF5sBvCyZ6AjkL
#
# ── Startup Order ────────────────────────────────────────────────────────────────
# 1. Start the 8 workers first (they will wait for the central Pi to appear)
# 2. Start the central Pi last (it will discover all workers via INITIAL_PEERS)

# HuggingFace token for gated models (not needed for Qwen, required for Llama)
HF_TOKEN=

# Model served by the swarm (HuggingFace model ID)
PETALS_MODEL=Qwen/Qwen2.5-7B-Instruct

# Petals swarm peers — list ALL 8 worker Pis here so the central Pi can find them
INITIAL_PEERS=\
/ip4/192.168.1.11/tcp/31336/p2p/QmXeMabY7dDfPtV3KcJzRqL8Wn9Hp2TgF5sBvCyZ6AjkL,\
/ip4/192.168.1.12/tcp/31336/p2p/QmYvNbcZ8eEgQuW4LdKAsRmL9Xo0Iq3UgH6tCwAzB7CklM,\
/ip4/192.168.1.13/tcp/31336/p2p/QmZwOcdA9fFhRvX5MeLBsSnN0Yp1Jr4VhI7uDxBaC8DlmN,\
/ip4/192.168.1.14/tcp/31336/p2p/QmAxPdeB0gGiSwY6NfMCtToO1Zq2Ks5WiJ8vEyCbD9EnO,\
/ip4/192.168.1.15/tcp/31336/p2p/QmByQefC1hHjTxZ7OgNDuUpP2Ar3Lt6XjK9wFzCcE0FpP,\
/ip4/192.168.1.16/tcp/31336/p2p/QmCzRfgD2iIkUyA8PhOEvVqQ3Bs4Mu7YkL0xGaCdF1GqQ,\
/ip4/192.168.1.17/tcp/31336/p2p/QmDaSghE3jJlVzB9QiPFwWrR4Ct5Nv8ZlM1yHbDeG2HrR,\
/ip4/192.168.1.18/tcp/31336/p2p/QmEbThiF4kKmWaC0RjQGxXsS5Du6Ow9AmN2zIcEfH3IsS

# Proxy retry settings
PROXY_MAX_RETRIES=3
PROXY_TIMEOUT=180

# Host ports
HOST_PORT_PROXY=11434
HOST_PORT_INFERENCE=31337
