# ===== POLLEN Environment Configuration =====
# LLM Backend
PETALS_ENDPOINT=http://localhost:11434

# Control Unit
LLM_MODEL=qwen3.5:27b
BACKEND_MODE=MOCK
API_AUTH_HEADERS=

# DB Gateway
DECOMPOSITION_MODEL=qwen3.5:27b

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin

# Mongo Express
ME_CONFIG_BASICAUTH_ENABLED=true
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=admin

# Qdrant
QDRANT_COLLECTION=services

# Microcks
MICROCKS_USER=admin
MICROCKS_PASS=admin

# Consul
CONSUL_HOST=registry
CONSUL_PORT=8500

# Internal hosts
REGISTRY_HOST=registry
MONGO_HOST=catalog-data
MONGO_PORT=27017
MONGO_DB=microcks
MONGO_USER=admin
MONGO_PASS=admin
QDRANT_HOST=catalog-vector
QDRANT_PORT=6333
CATALOG_GATEWAY_HOST=catalog-gateway
CATALOG_GATEWAY_PORT=5000
HEALTHCHECK_SERVICE_HOST=healthcheck-service
HEALTHCHECK_SERVICE_PORT=5600
MOCK_SERVER_HOST=mock-server
MOCK_SERVER_PORT=8080

# Host ports
HOST_PORT_CONSUL=8500
HOST_PORT_CONSUL_DNS=8600
HOST_PORT_MOCK_SERVER=8585
HOST_PORT_MONGO=27017
HOST_PORT_QDRANT_GRPC=6334
HOST_PORT_QDRANT_HTTP=6333
HOST_PORT_MONGO_EXPRESS=27018
HOST_PORT_CATALOG_GATEWAY=5000
HOST_PORT_CONTROL_UNIT=5500
HOST_PORT_REDIS=6379
HOST_PORT_REDIS_INSIGHT=6380
HOST_PORT_HEALTHCHECK=5600
HOST_PORT_API_IMPORTER=7500
